<Window x:Class="MspTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:MspTweaker"
        Title="Msp Tweaker" Width="1240" Height="800" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        BorderBrush="{DynamicResource Line}" BorderThickness="0"
        FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- one tweak: title and when it helps on the left, marks, status and the switch on the right -->
    <DataTemplate x:Key="RowTpl">
      <Grid Height="64">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding T.Title}" Style="{StaticResource Head}" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding T.Indication}" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource Muted}"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="RiskIcon" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,12,0"
                     Visibility="{Binding ShowRisk, Converter={StaticResource Vis}}" ToolTip="{Binding RiskSentence}"/>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Foreground="{DynamicResource Subtle}" Margin="0,0,12,0"
                     Visibility="{Binding T.Reboot, Converter={StaticResource Vis}}" ToolTip="{Binding [reboot], Source={x:Static m:L.I}}"/>
        </StackPanel>
        <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Label}" Foreground="{DynamicResource Subtle}"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Button Grid.Column="3" Style="{StaticResource Switch}" Click="Switch_Click" IsEnabled="{Binding CanToggle}"
                AutomationProperties.Name="{Binding SwitchName}" AutomationProperties.ItemStatus="{Binding StatusText}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding T.Stripe}" Value="Black">
          <Setter TargetName="RiskIcon" Property="Text" Value="&#xE945;"/>
          <Setter TargetName="RiskIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="todo">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource AccentText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Warn}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="bad">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Danger}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a group: label above a raised panel holding its rows -->
    <Style x:Key="GroupPanel" TargetType="GroupItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupItem">
            <StackPanel Margin="0,0,0,24">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,8"/>
              <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="4">
                <ItemsPresenter/>
              </Border>
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- label over value, like a spec sheet -->
    <Style x:Key="SpecValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid x:Name="Main">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <!-- title bar -->
      <DockPanel Grid.ColumnSpan="2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="LangEn" Style="{StaticResource Lang}" Content="EN" Click="LangEn_Click" AutomationProperties.Name="English"/>
          <Button x:Name="LangPt" Style="{StaticResource Lang}" Content="PT" Click="LangPt_Click" AutomationProperties.Name="Português"/>
          <Rectangle Width="1" Height="16" Fill="{DynamicResource Line}" Margin="8,0"/>
          <Button x:Name="ThemeButton" Style="{StaticResource Caption}" FontSize="13" Click="Theme_Click"
                  AutomationProperties.Name="{Binding [theme], Source={x:Static m:L.I}}"/>
          <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click"
                  AutomationProperties.Name="{Binding [minimize], Source={x:Static m:L.I}}"/>
          <Button Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="Close_Click"
                  AutomationProperties.Name="{Binding [close], Source={x:Static m:L.I}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Source="{StaticResource Logo}" Width="18" Height="18"/>
          <TextBlock Text="Msp Tweaker" Style="{StaticResource Head}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- tabs, with the summary and a pending reboot on the right -->
      <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel Height="56" Margin="32,0,24,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Summary" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <Button x:Name="Pending" Visibility="Collapsed" Style="{StaticResource Primary}" Margin="16,0,0,0" Click="Reboot_Click"
                    Content="{Binding [rebootNow], Source={x:Static m:L.I}}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TabSystem" Style="{StaticResource Tab}" GroupName="Tabs" IsChecked="True" Checked="Tab_Checked"
                         Content="{Binding [system], Source={x:Static m:L.I}}"/>
            <RadioButton x:Name="TabGames" Style="{StaticResource Tab}" GroupName="Tabs" Checked="Tab_Checked"
                         Content="{Binding [games], Source={x:Static m:L.I}}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- list page -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,24,32,32">

          <!-- system: what the tweaks are checked against -->
          <Border x:Name="SpecPanel" Background="{DynamicResource Surface}" CornerRadius="8" Padding="20,16" Margin="0,0,0,32">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding [cpu], Source={x:Static m:L.I}}" Style="{StaticResource Label}"/>
                <TextBlock x:Name="SpecCpu" Style="{StaticResource SpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="{Binding [gpu], Source={x:Static m:L.I}}" Style="{StaticResource Label}"/>
                <TextBlock x:Name="SpecGpu" Style="{StaticResource SpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Windows" Style="{StaticResource Label}"/>
                <TextBlock x:Name="SpecWin" Style="{StaticResource SpecValue}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- games: the game the section belongs to -->
          <StackPanel x:Name="GamePanel" Visibility="Collapsed" Margin="0,0,0,24">
            <TextBlock Text="Fortnite" Style="{StaticResource Head}" FontSize="20"/>
            <TextBlock x:Name="GamePath" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>

          <ListBox x:Name="List" Style="{StaticResource List}" ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource RowTpl}"
                   IsSynchronizedWithCurrentItem="True" AutomationProperties.Name="{Binding [tweaks], Source={x:Static m:L.I}}">
            <ListBox.GroupStyle>
              <GroupStyle ContainerStyle="{StaticResource GroupPanel}"/>
            </ListBox.GroupStyle>
          </ListBox>

          <!-- games: read-only connection test -->
          <StackPanel x:Name="DiagPanel" Visibility="Collapsed">
            <TextBlock Text="{Binding [diag], Source={x:Static m:L.I}}" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="20">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="DiagRun" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Top" Margin="24,0,0,0"
                          Content="{Binding [diagRun], Source={x:Static m:L.I}}" Click="Diag_Click"/>
                  <TextBlock Text="{Binding [diagBody], Source={x:Static m:L.I}}" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource Muted}"/>
                </DockPanel>
                <Grid x:Name="DiagResults" Visibility="Collapsed" Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding [diagLan], Source={x:Static m:L.I}}" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="DiagLan" Style="{StaticResource SpecValue}" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding [diagWan], Source={x:Static m:L.I}}" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="DiagWan" Style="{StaticResource SpecValue}" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="DiagVerdict" Style="{StaticResource Body}" FontSize="13" Margin="0,12,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- detail of the selected tweak -->
      <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Body}" FontSize="12" LineHeight="16" Foreground="{DynamicResource Subtle}" Margin="24,0,24,20">
            <Run Text="{Binding [backupNote], Source={x:Static m:L.I}, Mode=OneWay}"/><LineBreak/>
            <Run x:Name="BackupLocation" FontFamily="{StaticResource Mono}"/>
          </TextBlock>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" DataContext="{Binding SelectedItem, ElementName=List}">
            <StackPanel Margin="24">
              <TextBlock x:Name="PanelStatus" Text="{Binding StatusText}" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding T.Title}" Style="{StaticResource Head}" FontSize="20" LineHeight="28" Margin="0,4,0,0"/>

              <DockPanel Margin="0,12,0,0" Visibility="{Binding ShowRisk, Converter={StaticResource Vis}}">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,3,8,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                      <Setter Property="Text" Value="&#xE7BA;"/>
                      <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding T.Stripe}" Value="Black">
                          <Setter Property="Text" Value="&#xE945;"/>
                          <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding RiskSentence}" FontSize="13">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                      <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding T.Stripe}" Value="Black">
                          <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DockPanel>

              <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource Danger}" Margin="0,12,0,0"
                         Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>

              <TextBlock Text="{Binding [effect], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Margin="0,24,0,4"/>
              <TextBlock Text="{Binding T.Effect}" Style="{StaticResource Body}"/>

              <TextBlock Text="{Binding [contra], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Margin="0,20,0,4"/>
              <TextBlock Text="{Binding T.Contraindication}" Style="{StaticResource Body}"/>

              <TextBlock Text="{Binding [dosage], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Margin="0,20,0,8"/>
              <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Surface2}">
                <TextBlock Text="{Binding T.Dosage}" FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="20"
                           Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- confirmation: trade-offs are shown again before anything changes -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource Scrim}">
      <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" Padding="24"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
          <StackPanel x:Name="OvRisk" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="OvRiskIcon" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
            <TextBlock x:Name="OvRiskText" Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="OvTitle" Style="{StaticResource Head}" FontSize="20"/>
          <TextBlock x:Name="OvBody" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          <Border x:Name="OvDosageBox" Margin="0,16,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource Surface2}">
            <TextBlock x:Name="OvDosage" FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="OvCancel" Content="{Binding [cancel], Source={x:Static m:L.I}}" Style="{StaticResource Secondary}" Click="OvCancel_Click" IsCancel="True"/>
            <Button x:Name="OvOk" Style="{StaticResource Primary}" Click="OvOk_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

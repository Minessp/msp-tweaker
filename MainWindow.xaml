<Window x:Class="MspTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:MspTweaker"
        Title="Msp Tweaker" Width="1120" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        BorderBrush="{DynamicResource Line}" BorderThickness="0"
        FontFamily="{StaticResource Barlow}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate x:Key="TweakTpl">
      <Grid x:Name="Item" Margin="0,0,0,14" Background="Transparent">
        <Border x:Name="C1" Style="{StaticResource Corner}" BorderThickness="1.5,1.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Border x:Name="C2" Style="{StaticResource Corner}" BorderThickness="0,1.5,1.5,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Border x:Name="C3" Style="{StaticResource Corner}" BorderThickness="1.5,0,0,1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <Border x:Name="C4" Style="{StaticResource Corner}" BorderThickness="0,0,1.5,1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

        <StackPanel Margin="24,18,24,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,5,0,0">
              <Rectangle Style="{StaticResource Led}" Margin="0,1,9,0"/>
              <TextBlock x:Name="Status" Text="{Binding StatusText}" Style="{StaticResource Label}"/>
            </StackPanel>
            <TextBlock Text="{Binding T.Title}" Style="{StaticResource Head}" FontSize="21"/>
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding ShowMeta, Converter={StaticResource Vis}}">
            <StackPanel x:Name="Risk" Orientation="Horizontal" Margin="0,0,18,0" Visibility="Collapsed">
              <TextBlock x:Name="RiskIcon" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}"/>
              <TextBlock x:Name="RiskText" Text="{Binding RiskText}" Style="{StaticResource Label}" Foreground="{DynamicResource Warn}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding T.Reboot, Converter={StaticResource Vis}}">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Foreground="{DynamicResource Muted}"/>
              <TextBlock Text="{Binding [reboot], Source={x:Static m:L.I}}" Style="{StaticResource Label}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding T.Effect}" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" MaxWidth="620" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource Danger}" MaxWidth="620" HorizontalAlignment="Left"
                     Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>

          <DockPanel Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{Binding [revert], Source={x:Static m:L.I}}" Style="{StaticResource Secondary}" Click="Revert_Click"
                      Visibility="{Binding ShowRevert, Converter={StaticResource Vis}}" IsEnabled="{Binding Free}"
                      AutomationProperties.Name="{Binding RevertName}"/>
              <Button Content="{Binding [apply], Source={x:Static m:L.I}}" Style="{StaticResource Primary}" Click="Apply_Click" Margin="8,0,0,0"
                      Visibility="{Binding ShowApply, Converter={StaticResource Vis}}" IsEnabled="{Binding Free}"
                      AutomationProperties.Name="{Binding ApplyName}"/>
            </StackPanel>
            <ToggleButton Content="{Binding [details], Source={x:Static m:L.I}}" Style="{StaticResource Disclosure}"
                          IsChecked="{Binding Open}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </DockPanel>

          <Grid Visibility="{Binding Open, Converter={StaticResource Vis}}" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="118"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding [indication], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Margin="0,1,0,0"/>
            <TextBlock Grid.Column="1" Text="{Binding T.Indication}" Style="{StaticResource Body}" MaxWidth="600" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Text="{Binding [contra], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Margin="0,11,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding T.Contraindication}" Style="{StaticResource Body}" MaxWidth="600" HorizontalAlignment="Left" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="2" Text="{Binding [dosage], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Margin="0,15,0,0"/>
            <Border Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Padding="12,9" CornerRadius="3" Background="{DynamicResource Surface2}">
              <TextBlock Text="{Binding T.Dosage}" FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="18"
                         Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
            </Border>
          </Grid>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
          <Setter TargetName="C1" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
          <Setter TargetName="C2" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
          <Setter TargetName="C3" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
          <Setter TargetName="C4" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        </Trigger>
        <DataTrigger Binding="{Binding T.Stripe}" Value="Red">
          <Setter TargetName="Risk" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding T.Stripe}" Value="Black">
          <Setter TargetName="Risk" Property="Visibility" Value="Visible"/>
          <Setter TargetName="RiskIcon" Property="Text" Value="&#xE945;"/>
          <Setter TargetName="RiskIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
          <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="ok">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource AccentText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Warn}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="bad">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Danger}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid x:Name="Main">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="272"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- title bar -->
      <DockPanel Grid.ColumnSpan="2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="LangEn" Style="{StaticResource Lang}" Content="EN" Click="LangEn_Click" AutomationProperties.Name="English"/>
          <Button x:Name="LangPt" Style="{StaticResource Lang}" Content="PT" Click="LangPt_Click" AutomationProperties.Name="Português"/>
          <Rectangle Width="1" Height="16" Fill="{DynamicResource Line}" Margin="8,0"/>
          <Button x:Name="ThemeButton" Style="{StaticResource Caption}" FontSize="13" Click="Theme_Click"
                  AutomationProperties.Name="{Binding [theme], Source={x:Static m:L.I}}"/>
          <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click"
                  AutomationProperties.Name="{Binding [minimize], Source={x:Static m:L.I}}"/>
          <Button Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="Close_Click"
                  AutomationProperties.Name="{Binding [close], Source={x:Static m:L.I}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="{StaticResource Logo}" Width="22" Height="22"/>
          <TextBlock Text="Msp Tweaker" Style="{StaticResource Head}" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,2"/>
        </StackPanel>
      </DockPanel>

      <!-- sidebar: the board's status LED bank -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="26,14,24,20">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Cpu" Style="{StaticResource Head}" FontSize="18"/>
            <TextBlock x:Name="WinVer" Style="{StaticResource Body}" FontSize="13.5" Foreground="{DynamicResource Muted}"/>

            <ItemsControl x:Name="Bank" Margin="0,30,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Width="100"/>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Rectangle Style="{StaticResource Led}" Width="18" Height="7" Margin="0,0,7,0" ToolTip="{Binding T.Title}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Summary" Style="{StaticResource Body}" FontSize="15" Margin="0,8,0,0"/>
            <TextBlock x:Name="Skipped" Style="{StaticResource Body}" FontSize="13.5" Foreground="{DynamicResource Subtle}"/>

            <StackPanel Margin="0,30,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}"/>
                <TextBlock Text="{Binding [riskRed], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Foreground="{DynamicResource Warn}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Foreground="{DynamicResource Danger}"/>
                <TextBlock Text="{Binding [riskBlack], Source={x:Static m:L.I}}" Style="{StaticResource Label}" Foreground="{DynamicResource Danger}"/>
              </StackPanel>
              <TextBlock Text="{Binding [riskNone], Source={x:Static m:L.I}}" Style="{StaticResource Body}" FontSize="13.5" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="Pending" Visibility="Collapsed" CornerRadius="4" Padding="14,12,14,14" Margin="0,0,0,18" Background="{DynamicResource Surface}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="14" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource LedAmber}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                  <TextBlock Text="{Binding [pending], Source={x:Static m:L.I}}" Style="{StaticResource Head}" FontSize="15.5" Foreground="{DynamicResource Warn}"/>
                </StackPanel>
                <TextBlock Text="{Binding [pendingBody], Source={x:Static m:L.I}}" Style="{StaticResource Body}" FontSize="13.5" Margin="0,4,0,10"/>
                <Button Content="{Binding [rebootNow], Source={x:Static m:L.I}}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="Reboot_Click"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource Subtle}">
              <Run Text="{Binding [backupNote], Source={x:Static m:L.I}, Mode=OneWay}"/><LineBreak/>
              <Run x:Name="BackupLocation" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
            </TextBlock>
          </StackPanel>
          <Border/>
        </DockPanel>
      </Border>

      <!-- tweaks -->
      <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="34,8,30,32" MaxWidth="840" HorizontalAlignment="Left">
          <TextBlock Text="{Binding [title], Source={x:Static m:L.I}}" Style="{StaticResource Head}" FontSize="36"/>
          <TextBlock Text="{Binding [intro], Source={x:Static m:L.I}}" Style="{StaticResource Body}" FontSize="15" LineHeight="23"
                     Foreground="{DynamicResource Muted}" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,6"/>

          <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource TweakTpl}" Focusable="False">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,24,0,10">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" FontSize="16" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Label}" Foreground="{DynamicResource Subtle}" Margin="8,1,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- confirmation: trade-offs are shown again before anything changes -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource Scrim}">
      <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="6"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
          <Border x:Name="OvHatch" Height="8" CornerRadius="6,6,0,0"/>
          <StackPanel Margin="28,20,28,24">
            <StackPanel x:Name="OvRisk" Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock x:Name="OvRiskIcon" Style="{StaticResource Glyph}"/>
              <TextBlock x:Name="OvRiskText" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="OvTitle" Style="{StaticResource Head}" FontSize="25"/>
            <TextBlock x:Name="OvBody" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            <Border x:Name="OvDosageBox" Margin="0,14,0,0" Padding="12,9" CornerRadius="3" Background="{DynamicResource Surface2}">
              <TextBlock x:Name="OvDosage" FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="OvCancel" Content="{Binding [cancel], Source={x:Static m:L.I}}" Style="{StaticResource Secondary}" Click="OvCancel_Click" IsCancel="True"/>
              <Button x:Name="OvOk" Style="{StaticResource Primary}" Click="OvOk_Click" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

<Application x:Class="MspTweaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Logo.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- color brushes come from Theme.cs. Barlow regular width for reading, SemiCondensed for headings and controls -->
      <FontFamily x:Key="Barlow">pack://application:,,,/Fonts/#Barlow</FontFamily>
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
      <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <BooleanToVisibilityConverter x:Key="Vis"/>

      <Style x:Key="Focus">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Margin="-3" CornerRadius="5" BorderBrush="{DynamicResource AccentText}" BorderThickness="2"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </Style>

      <Style x:Key="Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </Style>

      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      </Style>

      <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,1,6,0"/>
      </Style>

      <!-- component outline on a PCB silkscreen: only the corners are drawn -->
      <Style x:Key="Corner" TargetType="Border">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      </Style>

      <!-- SMD status LED. Reads Tone from the Card in its DataContext -->
      <Style x:Key="Led" TargetType="Rectangle">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="RadiusX" Value="1"/>
        <Setter Property="RadiusY" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource LedOff}"/>
        <Setter Property="Stroke" Value="{DynamicResource LedRim}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="ok">
            <Setter Property="Fill" Value="{DynamicResource LedGold}"/>
            <Setter Property="Stroke" Value="{x:Null}"/>
            <Setter Property="Effect">
              <Setter.Value>
                <DropShadowEffect Color="#FFC94A" ShadowDepth="0" BlurRadius="9" Opacity="0.75"/>
              </Setter.Value>
            </Setter>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter Property="Fill" Value="{DynamicResource LedRed}"/>
            <Setter Property="Stroke" Value="{x:Null}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="warn">
            <Setter Property="Fill" Value="{DynamicResource LedAmber}"/>
            <Setter Property="Stroke" Value="{x:Null}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="na">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Opacity" Value="0.45"/>
          </DataTrigger>
          <!-- blinking only when Windows animations are on -->
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Tone}" Value="warn"/>
              <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions>
              <BeginStoryboard x:Name="Blink">
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
              </BeginStoryboard>
            </MultiDataTrigger.EnterActions>
            <MultiDataTrigger.ExitActions>
              <RemoveStoryboard BeginStoryboardName="Blink"/>
            </MultiDataTrigger.ExitActions>
          </MultiDataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Tone}" Value="busy"/>
              <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions>
              <BeginStoryboard x:Name="Pulse">
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
              </BeginStoryboard>
            </MultiDataTrigger.EnterActions>
            <MultiDataTrigger.ExitActions>
              <RemoveStoryboard BeginStoryboardName="Pulse"/>
            </MultiDataTrigger.ExitActions>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>

      <!-- PCB keep-out hatching, used only to mark a confirmation that touches drivers, boot or kernel -->
      <DrawingBrush x:Key="HatchWarn" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Viewbox="0,0,10,10" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="#F2B54A" Geometry="M0,10 L10,0 L10,5 L5,10 Z M0,5 L5,0 L0,0 Z"/>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <DrawingBrush x:Key="HatchDanger" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Viewbox="0,0,10,10" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="#E0482F" Geometry="M0,10 L10,0 L10,5 L5,10 Z M0,5 L5,0 L0,0 Z"/>
        </DrawingBrush.Drawing>
      </DrawingBrush>

      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Padding" Value="18,5,18,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" CornerRadius="3" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Opacity" Value="0.86"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="B" Property="Opacity" Value="0.72"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
        <Setter Property="Foreground" Value="White"/>
      </Style>

      <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" CornerRadius="3" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Disclosure" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <ContentPresenter VerticalAlignment="Center"/>
                <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9"
                           VerticalAlignment="Center" Margin="7,2,0,0"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Caption" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource Caption}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource CloseHover}"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Lang" TargetType="Button" BasedOn="{StaticResource Caption}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13.5"/>
      </Style>

      <!-- shortcut: vertical only; no view in this app scrolls horizontally -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Width="6" CornerRadius="3" Background="{DynamicResource Subtle}" Opacity="0.6"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="1"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>

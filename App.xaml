<Application x:Class="MspTweaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Logo.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- color brushes come from Theme.cs. IBM Plex Sans embedded from Fonts/ (OFL).
           Type scale: 12 meta and code, 13 secondary, 14 body and row titles, 16 tabs, 20 panel title -->
      <FontFamily x:Key="Sans">pack://application:,,,/Fonts/#IBM Plex Sans</FontFamily>
      <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#IBM Plex Mono</FontFamily>
      <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <BooleanToVisibilityConverter x:Key="Vis"/>

      <Style x:Key="Focus">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Margin="-4" CornerRadius="8" BorderBrush="{DynamicResource Text}" BorderThickness="2"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- inset ring for elements with no room around them -->
      <Style x:Key="InsetFocus">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border CornerRadius="6" BorderBrush="{DynamicResource Text}" BorderThickness="2"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </Style>

      <Style x:Key="Head" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </Style>

      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      </Style>

      <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="B" Property="Opacity" Value="0.76"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
        <Setter Property="Foreground" Value="White"/>
      </Style>

      <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource LineStrong}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- on/off switch for a tweak. It is a Button, not a ToggleButton: the state shown is the live Windows state, never a local click -->
      <Style x:Key="Switch" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid Background="Transparent">
                <Border x:Name="Track" CornerRadius="11" Background="Transparent" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"/>
                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text}"/>
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text}"/>
                </Trigger>
                <!-- after the hover trigger so the on state wins -->
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentFg}"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
                <!-- on, but not ours to switch off: grey instead of a washed-out orange -->
                <DataTrigger Binding="{Binding OnLocked}" Value="True">
                  <Setter Property="Opacity" Value="1"/>
                  <Setter Property="Cursor" Value="Arrow"/>
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource LineStrong}"/>
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text}"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- page tabs: text with an underline on the active one -->
      <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource InsetFocus}"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,32,0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent">
                <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,4"/>
                <Rectangle x:Name="Bar" Height="2" VerticalAlignment="Bottom" Fill="Transparent"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                  <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- tweak list without its own scroller, so the page scrolls as one -->
      <Style x:Key="List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Row" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource InsetFocus}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding T.Title}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="B" CornerRadius="6" Background="Transparent" Padding="16,0">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Caption" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource InsetFocus}"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource Caption}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource CloseHover}"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Lang" TargetType="Button" BasedOn="{StaticResource Caption}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>

      <!-- shortcut: vertical only; no view in this app scrolls horizontally -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Width="4" CornerRadius="2" Background="{DynamicResource Subtle}" Opacity="0.6"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="1"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
